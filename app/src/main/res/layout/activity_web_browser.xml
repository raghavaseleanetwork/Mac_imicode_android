<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_web_screen"
    android:fitsSystemWindows="true">

    <!-- ============ TOP BAR: back + title + menu ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/btnCloseBrowser"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close browser"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Web"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/btnBrowserMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Browser menu"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- ============ ADDRESS BAR ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_web_toolbar"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search or type a URL"
            app:tint="#ADADAD" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint="Search or type a website"
            android:textColorHint="#6B6B6B"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:selectAllOnFocus="true"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/btnReloadOrStop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- ============ LOADING PROGRESS ============ -->
    <ProgressBar
        android:id="@+id/progressWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF7F2E"
        android:progressBackgroundTint="#00000000"
        android:visibility="invisible" />

    <!-- ============ PAGE ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Start screen shown before the first page loads -->
        <LinearLayout
            android:id="@+id/layoutStartScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_web_screen"
            android:paddingStart="34dp"
            android:paddingEnd="34dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_web"
                android:contentDescription="Web"
                app:tint="#FF7F2E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Web"
                android:textColor="#FF7F2E"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Browse inside Imi. Your logins stay saved here, so you only sign in once."
                android:textColor="#ADADAD"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Quick links -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="26dp">

                <TextView
                    android:id="@+id/chipGoogle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Google"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/bg_web_toolbar"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipYoutube"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="YouTube"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/bg_web_toolbar"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipGemini"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Gemini"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/bg_web_toolbar"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- AI services: sign in once here, then ask about your work -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/chipClaude"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Claude"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/bg_web_toolbar"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipChatGpt"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="ChatGPT"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/bg_web_toolbar"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="Tap the chat icon below to type or speak a command."
                android:textColor="#6B6B6B"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============ AGENT STATUS STRIP ============ -->
    <LinearLayout
        android:id="@+id/layoutAgentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_web_agent_strip"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressAgent"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="#FF7F2E" />

        <TextView
            android:id="@+id/tvAgentStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Working…"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnAgentContinue"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Continue"
            android:textColor="#0B0D0C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_web_agent_cta"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnAgentStop"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="6dp"
            android:text="Stop"
            android:textColor="#FF7F2E"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ============ COMMAND BAR ============ -->
    <LinearLayout
        android:id="@+id/layoutCommandBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_web_toolbar"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Tell me what to do on this page"
            android:textColorHint="#6B6B6B"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/btnHistory"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="2dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_down"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Recent commands"
            app:tint="#ADADAD" />

        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:padding="7dp"
            android:src="@drawable/ic_mic"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Speak a command"
            app:tint="#FF7F2E" />

        <ImageView
            android:id="@+id/btnSendCommand"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_right"
            android:background="@drawable/bg_web_agent_cta"
            android:contentDescription="Run command"
            app:tint="#0B0D0C" />
    </LinearLayout>

    <!-- ============ BOTTOM CONTROLS ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:weightSum="4">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_right"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:padding="9dp"
            android:src="@drawable/ic_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnCommand"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:padding="9dp"
            android:src="@drawable/ic_chat"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="AI command"
            app:tint="#FF7F2E" />
    </LinearLayout>

</LinearLayout>
